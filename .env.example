# Glass Vault model settings. Copy to .env (gitignored) and fill in the keys.
# Any OpenAI-compatible chat-completions endpoint with tool calling works:
# Tencent Hunyuan, DeepSeek (direct, or hosted on Tencent Cloud), or OpenAI.
# Real environment variables override this file.

# --- Drafter (turns the conversation into a draft plan) --------------------
# Tencent Hunyuan's OpenAI-compatible endpoint; check the base URL and model
# names available to your account in the Tencent Cloud console.
GV_LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
GV_LLM_API_KEY=
GV_DRAFTER_MODEL=hunyuan-turbos-latest

# --- Validator (independently re-derives the plan; never sees the draft) ---
# Prefer a different model family from the drafter so the two readings do not
# share one blind spot. To run both roles on the drafter's endpoint instead,
# delete the two overrides below and pick another model that endpoint serves.
GV_VALIDATOR_MODEL=deepseek-chat
GV_VALIDATOR_BASE_URL=https://api.deepseek.com
GV_VALIDATOR_API_KEY=

# --- Optional -------------------------------------------------------------
# Seconds before a model call times out (default 30).
# GV_LLM_TIMEOUT=30
# Extra provider-specific request fields, as a JSON object, per role.
# e.g. switch off Hunyuan's search enhancement for the drafter:
# GV_DRAFTER_EXTRA_BODY={"enable_enhancement": false}
# GV_VALIDATOR_EXTRA_BODY={}
