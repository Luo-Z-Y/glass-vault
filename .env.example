# Glass Vault model settings. Copy to .env (gitignored) and fill in the keys.
# Any OpenAI-compatible chat-completions endpoint with tool calling works:
# DeepSeek, Tencent Hunyuan (via TokenHub), or OpenAI.
# Real environment variables override this file.

# --- Drafter (turns the conversation into a draft plan) --------------------
# DeepSeek's own API. Its model ids are deepseek-flash and deepseek-v4-pro;
# the old deepseek-chat / deepseek-reasoner ids were retired in July 2026.
GV_LLM_BASE_URL=https://api.deepseek.com
GV_LLM_API_KEY=
GV_DRAFTER_MODEL=deepseek-flash

# --- Validator (independently re-derives the plan; never sees the draft) ---
# Prefer a different model from the drafter so the two readings are less
# likely to share one blind spot. It uses the drafter's endpoint and key
# unless given its own. For a different model family, Tencent Hunyuan Hy3:
#
# Through OpenRouter (key from https://openrouter.ai/settings/keys). "only
# tencent" keeps the request on Tencent's own endpoint, which takes tool_choice
# "auto" but not "required"; the client falls back to "auto" by itself. Use
# these four lines in place of the two DeepSeek validator lines below:
#   GV_VALIDATOR_BASE_URL=https://openrouter.ai/api/v1
#   GV_VALIDATOR_API_KEY=
#   GV_VALIDATOR_MODEL=tencent/hy3
#   GV_VALIDATOR_EXTRA_BODY={"reasoning": {"effort": "none"}, "provider": {"only": ["tencent"]}}
#
# Or on Tencent Cloud International TokenHub directly (needs ID review):
#   GV_VALIDATOR_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1
#   GV_VALIDATOR_API_KEY=
#   GV_VALIDATOR_MODEL=hy3
GV_VALIDATOR_MODEL=deepseek-v4-pro

# --- Thinking mode -----------------------------------------------------------
# Extra provider-specific request fields, as a JSON object, per role.
# DeepSeek (and Hunyuan hy3) think by default. In thinking mode DeepSeek
# rejects tool_choice="required" and returns 400 unless every earlier
# reasoning_content is sent back, which the drafter's repair round does not
# do. Keep thinking off for both roles.
GV_DRAFTER_EXTRA_BODY={"thinking": {"type": "disabled"}}
GV_VALIDATOR_EXTRA_BODY={"thinking": {"type": "disabled"}}

# --- Optional -------------------------------------------------------------
# Seconds before a model call times out (default 30).
# GV_LLM_TIMEOUT=30

# --- Voice: Tencent RTC (optional) -------------------------------------------
# Without these, the web demo uses the browser's own speech.
# Text-to-speech (the bank voice): the TRTC app's SDKAppID, plus a cloud API key
# pair from https://console.tencentcloud.com/cam/capi
GV_TRTC_SDK_APP_ID=
GV_TENCENT_SECRET_ID=
GV_TENCENT_SECRET_KEY=
# Speech recognition (push-to-talk): the TRTC app's SDKSecretKey (App Management
# > your app > Basic Information). Not the same key as GV_TENCENT_SECRET_KEY.
GV_TRTC_SDK_SECRET_KEY=
# Optional: the voice, model and endpoints. The defaults suit an international
# (tencentcloud.com / trtc.io) account; a China-site account uses
# trtc.tencentcloudapi.com and asr.cloud-rtc.com.
#   GV_TRTC_VOICE=v-female-p9Xy7Q1L
#   GV_TRTC_TTS_MODEL=flow_01_turbo
#   GV_TRTC_TTS_HOST=trtc.intl.tencentcloudapi.com
#   GV_TRTC_TTS_REGION=ap-singapore
#   GV_TRTC_ASR_HOST=asr-intl.cloud-rtc.com
# Recognition language; set it empty in this file to let the model detect it.
#   GV_TRTC_ASR_LANGUAGE=en
